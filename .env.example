# The site's public URL, no trailing slash. Used for canonical URLs, the sitemap, OG images,
# llms.txt and the shadcn install commands. Without it, Vercel's production URL is used,
# and locally http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://linework.devsloka.in

# --- Install counts: Upstash Redis (optional) --------------------------------------------------
# Locally you can leave these empty: counts are kept in .installs.json instead.
# On Vercel they are required for counting, or counting stays off.

# Set by Vercel's Upstash integration (Storage -> Upstash for Redis). The app reads these two:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Also set by the integration; the app does not use them, kept so this file matches .env:
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
REDIS_URL=

# Or, with a database made directly at upstash.com, its REST credentials (used if set):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
